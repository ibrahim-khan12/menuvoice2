{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/website/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "menu.avitaldrel.com"
        }
      ],
      "destination": "https://app.meetmymenu.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy/index.html" }
  ],
  "functions": {
    "api/chat.ts": { "maxDuration": 60 },
    "api/scrape.ts": { "maxDuration": 30 },
    "api/menu-from-url.ts": { "maxDuration": 60 },
    "api/find-menu.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron-morning", "schedule": "0 11 * * *" }
  ]
}
